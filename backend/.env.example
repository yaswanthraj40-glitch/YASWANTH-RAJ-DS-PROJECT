# CoolRoute Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (optional - chatbot works without it using local responses)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Mapbox Access Token (required for 3D map)
# Get from: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.your.mapbox.token.here

# Google Earth Engine (for satellite data)
# Setup: https://developers.google.com/earth-engine/guides/python_install
GEE_PROJECT_ID=your-gee-project

# Server Config
PORT=8000
HOST=0.0.0.0
DEBUG=true
